# Loom Loyalty: dashboard → Developers → API Keys. Give the key only the read-only AI Bot role.
LOOM_LOYALTY_API_URL=https://api.loomloyalty.com
LOOM_LOYALTY_API_KEY=

# Stands in for your signed-in shopper: a customer's external id in Loom Loyalty.
LOOM_LOYALTY_DEMO_CUSTOMER_EXTERNAL_ID=

# Vercel AI Gateway. Not needed on Vercel (OIDC); set it for local dev.
AI_GATEWAY_API_KEY=
# Optional: any AI Gateway model id.
# AI_MODEL=anthropic/claude-haiku-5.5
